# ==============================================================================
# HireMe Agent - Environment Configuration Example
# Copy this file to .env and replace the placeholders with your actual API keys.
# DO NOT commit your .env file to public version control!
# ==============================================================================

# Primary LLM Provider (Groq API for ultra-fast response times)
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Backup LLM Provider (Google Gemini API via Google AI Studio for unlimited free fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# Adzuna Jobs API credentials (free signup at https://developer.adzuna.com/)
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here
ADZUNA_COUNTRY=gb
